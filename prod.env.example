# Credentials and infrastructure-specific values for the production runtime.
# Public service endpoints and safe defaults are in the checked-in config.toml.
# Heroku Config Vars are the production source for these values; do not commit prod.env.
# PROXY_TRUSTED_IPS is the one thing worth overriding there: set it to the real reverse
# proxy/router CIDR ranges. Trusting forwarded headers from arbitrary clients lets a caller evade
# the per-client rate limit. config.toml ships * only because Heroku publishes no router ranges and
# keys authenticated traffic by bearer token instead; a deployment behind a known proxy has no such
# excuse.
PROXY_TRUSTED_IPS=<trusted-proxy-cidrs>

# Supabase Connect > Session pooler URL; include sslmode=require.
DATABASE_URL=<supabase-session-pooler-url-with-sslmode-require>

# Supabase Storage S3 credentials for the private trove-private bucket.
S3_ACCESS_KEY=<supabase-storage-s3-access-key>
S3_SECRET_KEY=<supabase-storage-s3-secret-key>

# Base64-encoded service-account JSON with Vertex AI User permission.
VERTEX_SERVICE_ACCOUNT_JSON_B64=<base64-encoded-service-account-json>

# Supabase publishable (or legacy anon) key. Public by design, but a per-project value, so
# config.toml does not carry it. Never a service-role or secret key: startup refuses one here.
SUPABASE_AUTH_API_KEY=<supabase-publishable-or-anon-key>

# Server-only Supabase secret key for account deletion (replaces legacy service_role key).
SUPABASE_SECRET_KEY=<supabase-secret-key>
