# Select with RUN_ENV=stage. Set deployment secrets as Heroku Config Vars.
#
# Stage has no config.toml section: it runs its own Supabase project, so it states its own
# endpoints and keys below. Settings that are the same everywhere (port, upload cap, storage bucket,
# Vertex location, token audience) come from config.toml [defaults] and only need repeating here to
# differ from them.

# Supabase Connect > Session pooler connection string; include sslmode=require.
DATABASE_URL=<supabase-session-pooler-url-with-sslmode-require>

# The staging Supabase project and the endpoints its tokens are verified against.
SUPABASE_URL=https://<staging-project-ref>.supabase.co
S3_ENDPOINT=https://<staging-project-ref>.supabase.co/storage/v1/s3
S3_REGION=<project-region>
AUTH_JWKS_URL=https://<staging-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://<staging-project-ref>.supabase.co/auth/v1

# Supabase Storage > S3 Configuration access keys.
S3_ACCESS_KEY=<supabase-storage-s3-access-key>
S3_SECRET_KEY=<supabase-storage-s3-secret-key>

# Publishable (or legacy anon) key plus the server-only secret key; see local.env.example.
SUPABASE_AUTH_API_KEY=<supabase-publishable-or-anon-key>
SUPABASE_SECRET_KEY=<supabase-secret-key>

# Base64-encoded service account JSON with the Vertex AI User role, for the project named below.
VERTEX_SERVICE_ACCOUNT_JSON_B64=<base64-encoded-service-account-json>
VERTEX_PROJECT_ID=<google-cloud-project-id>

# Where browsers may call this API from, and the MCP endpoint it advertises.
CORS_ORIGIN=https://staging.example.com
MCP_PUBLIC_URL=https://<staging-api-domain>/mcp
# Comma-separated addresses or CIDRs of the proxy that terminates TLS in front of this process.
# uvicorn takes the client address from X-Forwarded-For only for requests arriving from these, and
# that address is the API's per-client rate-limit key. On Heroku this is the routing mesh range.
PROXY_TRUSTED_IPS=<proxy-cidr>
