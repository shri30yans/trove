# Set RUN_ENV=local when starting the API (it also runs the queue) or the migrator.
# Even in local development, Trove uses Supabase for Postgres and file storage.
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=*

# Supabase Connect > Session pooler connection string; include sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Storage > S3 Configuration. Create a private bucket named trove-private.
S3_ENDPOINT=https://<development-project-ref>.supabase.co/storage/v1/s3
S3_REGION=<project-region>
S3_BUCKET=trove-private
S3_ACCESS_KEY=<supabase-storage-s3-access-key>
S3_SECRET_KEY=<supabase-storage-s3-secret-key>
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=52428800

# Base64-encoded service account JSON with the Vertex AI User role; or set
# GOOGLE_APPLICATION_CREDENTIALS to a local ADC credential file path.
VERTEX_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_PROJECT_ID=gen-lang-client-0736864310
VERTEX_LOCATION=us

AUTH_AUDIENCE=authenticated
MCP_PUBLIC_URL=http://localhost:4000/mcp
AUTH_JWKS_URL=https://<development-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://<development-project-ref>.supabase.co/auth/v1
# Supabase Auth credentials stay on the API. Use the project's publishable or legacy anon key.
SUPABASE_URL=https://<development-project-ref>.supabase.co
SUPABASE_AUTH_API_KEY=<supabase-publishable-or-anon-key>
