# Set RUN_ENV=local when starting the API (it also runs the queue) or the migrator.
# Even in local development, Trove uses Supabase for Postgres and file storage.
#
# Only credentials and per-project values belong here. Every other setting comes from the
# checked-in config.toml; `python -m app.config` prints each effective key with the layer that
# supplied it. A deployment may still override any of those with an environment variable.

# Supabase Connect > Session pooler connection string; include sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Storage > S3 Configuration: access keys for the private trove-private bucket.
S3_ACCESS_KEY=<supabase-storage-s3-access-key>
S3_SECRET_KEY=<supabase-storage-s3-secret-key>

# Supabase Publishing API keys. The publishable (or legacy anon) key is public by design and
# config.toml does not carry it because it is per-project; never put a secret or service-role key
# in SUPABASE_AUTH_API_KEY — startup refuses one. SUPABASE_SECRET_KEY is server-only and required,
# because account deletion calls the Auth admin API.
SUPABASE_AUTH_API_KEY=<supabase-publishable-or-anon-key>
SUPABASE_SECRET_KEY=<supabase-secret-key>

# Base64-encoded service account JSON with the Vertex AI User role, for the project config.toml
# names. Without it the embedding capability reports itself absent; there is no second credential path.
VERTEX_SERVICE_ACCOUNT_JSON_B64=
